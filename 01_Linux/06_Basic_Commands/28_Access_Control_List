# remove all extended ACL entries 
setfacl -b file          --> Removes all extended access ACL entries from the specified file, leaving its base ACL entries.
setfacl -b directory     --> Removes extended access ACL entries from the specified directory only. It does not affect files or subdirectories inside it.
setfacl -Rb directory    --> Removes extended access ACL entries recursively from the directory and its contents.


# remove default ACL entries
setfacl -k directory    --> Removes the default ACL from the specified directory only.
setfacl -Rk directory    --> Removes default ACLs recursively from the starting directory and its subdirectories.
        or
find directory -type d -exec setfacl -k {} +


# remove both extended ACL entries & default ACL entries
setfacl -bk directory    --> Removes extended access ACL entries and the default ACL from the specified directory only.
setfacl -Rbk directory    --> Removes extended access ACL entries and default ACLs recursively throughout the directory tree.
         or
find directory -exec setfacl -bk {} +


# to find all files & directories which have acl
find / -exec getfacl -s {} + 2>/dev/null | grep '^# file:'     -->  -s — skips files that have only the base ACL entries (no extended ACL entries).
